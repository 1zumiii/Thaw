    },
    "Item arrangement is set to Manual, so %@ only hides and shows items. To reorder from here, switch it to Automatic in Settings %@ Layout, or ⌘-drag items in the menu bar yourself." : {
      "comment" : "Explanation shown when a layout-editor reorder is refused because arrangement mode is Manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
