      }
    },
    "%@ failed with exit status %d." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ failed with exit status %2$d."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 失败，退出状态为 %d。"
          }
        }
      }
    },
    "%@ failed with exit status %d: %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ failed with exit status %2$d: %3$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 失败，退出状态为 %d：%@"
          }
        }
      }
    },
    "%@ has its origins in Ice by Jordan Baird. Thank you for where it started." : {
      "comment" : "Origins acknowledgement; %%@ is the app name.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 源于 Jordan Baird 开发的 Ice。感谢他开启了这个项目。"
          }
        }
      }
    },
    "%@ hides the icons you don't need and brings them back with a click on its menu bar icon." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 会隐藏你不需要的图标。点按它的菜单栏图标即可恢复这些图标。"
          }
        }
      }
    },
    "%@ icon" : {
