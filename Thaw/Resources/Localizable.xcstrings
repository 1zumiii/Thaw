            "value" : "自动下载并安装更新"
          }
        }
      }
    },
    "Drag an icon into Hidden to tuck it away. Click %@'s icon in the menu bar to bring it back." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
