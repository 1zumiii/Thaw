    "Let Thaw keep items in your Layout order, or arrange them yourself by ⌘-dragging in the menu bar." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让 Thaw 按布局顺序保留项目，或按住 ⌘ 在菜单栏中拖动项目自行排列。"
          }
        }
      }
    },
    "Lets %@ hide apps with the same switch System Settings > Menu Bar uses." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许 %@ 使用系统设置 > 菜单栏中的同一个开关隐藏应用。"
          }
        }
      }
    },
    "Lets %@ keep Live Activities and the camera indicator on the menu bar while apps are hidden." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许 %@ 在应用隐藏时让实时活动和相机指示器保留在菜单栏中。"
          }
        }
      }
    },
    "Lets %@ update macOS's saved menu bar layout directly, so items move into place without your pointer moving." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许 %@ 直接更新 macOS 保存的菜单栏布局，让项目在指针不动的情况下移动到位。"
          }
        }
      }
    },
    "Lets Thaw capture menu bar item images for search, the layout editor and the Thaw Bar. Optional." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
