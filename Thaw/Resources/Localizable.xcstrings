    },
    "%@ uses the permissions below to manage your menu bar. Permission checks happen on your Mac." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 使用以下权限来管理你的菜单栏。权限检查发生在你的 Mac 上。"
          }
        }
      }
    },
    "%@ will delete its cache folder and quit. Launch the app again afterward." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 将删除其缓存文件夹并退出。之后再次启动该应用。"
          }
