    "%@ - Simple Mode" : {
      "comment" : "Settings window title while Simple Mode is on; %@ is the app name.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ - 简单模式"
