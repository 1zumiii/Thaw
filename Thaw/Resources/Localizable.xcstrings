    "%@ %@ running, but %@ can't see their menu bar items, so it can't hide or arrange them. Relaunching %@ fixes this." : {
      "comment" : "Layout pane warning when running apps' menu bar items are invisible to Thaw's scan. The first argument is a list of app names.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@ running, but %3$@ can't see their menu bar items, so it can't hide or arrange them. Relaunching %4$@ fixes this."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@ 正在运行，但 %@ 看不到它们的菜单栏项目，因此无法隐藏或排列它们。重新启动 %@ 可以修复此问题。"
          }
        }
      }
    },
