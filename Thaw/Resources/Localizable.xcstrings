      }
    },
    "Drag icons between Visible and Hidden. Hidden icons come back with a click on %@'s icon." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在显示和隐藏之间拖动图标。点按 %@ 的图标即可恢复隐藏图标。"
          }
        }
      }
    },
    "Drag items between sections. Hold ⌘ Command to drag in the menu bar." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在分区之间拖动项目。按住 ⌘ Command 可直接在菜单栏中拖动。"
          }
        }
      }
    },
    "Drag items between sections. Move New Items to choose where future items appear." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
