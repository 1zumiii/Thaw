    "took %lld ms" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "耗时 %lld 毫秒"
          }
        }
      }
    },
    "“%@” can’t be grouped" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”无法分组"
          }
        }
      }
    },
    "“%@” can’t be hidden by macOS." : {
      "comment" : "Reason a group move was refused: hiding unsupported for this app",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 无法隐藏“%@”。"
          }
        }
      }
    },
    "“%@” can’t be hidden." : {
      "comment" : "Reason a group move was refused: item not hideable",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法隐藏“%@”。"
          }
        }
      }
    },
    "“%@” can’t be moved" : {
      "comment" : "Title shown when a drag starts on an item macOS does not allow to move",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法移动“%@”"
          }
        }
      }
    },
    "“%@” can’t be moved out of the menu bar." : {
      "comment" : "Reason a group move was refused: a protected item",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法将“%@”移出菜单栏。"
          }
        }
      }
    },
    "“%@” can’t be moved until “Allow hiding macOS system items” is turned on in Layout settings" : {
      "comment" : "Move refusal sentence for a forced-visible MenuBarAgent module; actionable via the Layout setting.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必须先在布局设置中打开“允许隐藏 macOS 系统项目”，才能移动“%@”"
          }
        }
      }
    },
    "“%@” could not be placed. The items it was dropped beside have disappeared" : {
      "comment" : "Error sentence for a move whose destination anchor and every fallback anchor disappeared between the drop and execution.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法放置“%@”。它放置到旁边的项目已消失。"
          }
        }
      }
    },
    "“%@” couldn’t move to %@" : {
      "comment" : "Title shown when a whole-group move was refused\nTitle shown when an Apple item was refused because system item hiding is off\nTitle shown when an item cannot be assigned to a section\nTitle shown when the Thaw control icon is dropped outside the Visible section",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%1$@” couldn’t move to %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”无法移动到 %@"
          }
        }
      }
    },
    "“%@” didn’t finish regrouping" : {
      "comment" : "Title shown when a group reorder did not converge",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”未完成重新分组"
          }
        }
      }
    },
    "“%@” is anchored by macOS and cannot be moved" : {
      "comment" : "Move refusal sentence for a system-anchored item such as Clock, Control Center, or Siri.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”由 macOS 锚定，无法移动"
          }
        }
      }
    },
    "“%@” is kept in place by macOS outside the menu bar agent’s layout and cannot be moved" : {
      "comment" : "Move refusal sentence for an item that is forced visible but outside the MenuBarAgent namespace, so the experimental assertion cannot reach it.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”由 macOS 保持在菜单栏代理布局之外的位置，无法移动"
          }
        }
      }
    },
    "“%@” is macOS’s overflow arrow, not a menu bar item, and cannot be moved" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”是 macOS 的溢出箭头，不是菜单栏项目，无法移动"
          }
        }
      }
    },
    "“%@” is one of Thaw’s own control items and cannot be moved" : {
      "comment" : "Move refusal sentence for one of Thaw's own control items (not the visible one).",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”是 Thaw 自己的控制项目，无法移动"
          }
        }
      }
    },
    "“%@” is placed by macOS itself and cannot be moved" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”由 macOS 放置，无法移动"
          }
        }
      }
    },
    "“%@” is the macOS overflow control, not a menu bar item, and cannot be moved" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”是 macOS 的溢出控件，不是菜单栏项目，无法移动"
          }
        }
      }
    },
    "“%@” will be deleted. You can undo this with Command-Z." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”将被删除。你可以使用 Command-Z 撤销。"
          }
        }
      }
    },
    "“Who arranges items” is set to Manual, so %@ only hides and shows items. To reorder from here, set it to Automatic in Settings %@ Layout. Or ⌘-drag items in the menu bar yourself." : {
      "comment" : "Explanation shown when a layout-editor reorder is refused because arrangement mode is Manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“Who arranges items” is set to Manual, so %1$@ only hides and shows items. To reorder from here, set it to Automatic in Settings %2$@ Layout. Or ⌘-drag items in the menu bar yourself."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“项目排列方式”已设为“手动”，因此 %@ 只会隐藏和显示项目。要从这里重新排序，请在设置 %@ 布局中将它设为“自动”。或者在菜单栏中按住 ⌘ 自行拖动项目。"
          }
        }
      }
    },
