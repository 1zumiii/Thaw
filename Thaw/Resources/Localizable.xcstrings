    "Hide again after" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再次隐藏的时间"
          }
        }
      }
    },
    "Hide an item first. Anything in Hidden or Always Hidden can be set to reappear when its icon changes." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先隐藏项目。隐藏或始终隐藏中的项目都可以设置为图标变化时重新显示。"
          }
        }
      }
    },
    "Hide an item first. Anything in the hidden or always-hidden section can be set to reappear when its icon changes." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先隐藏项目。隐藏或始终隐藏分区中的项目都可以设置为图标变化时重新显示。"
          }
        }
      }
    },
    "Hide app menus when showing menu bar items" : {
      "comment" : "A toggle that lets the user decide whether to hide the app menus when displaying menu bar items.",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V řádku nabídek upřednostňovat ikony před nabídkami aplikací"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anwendungs-Menüs verstecken, wenn die Menüleisten-Einträge angezeigt werden"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocultar los menús de la app al mostrar los elementos de la barra de menús"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masquer les menus des apps lors de l'affichage des éléments de la barre des menus"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alkalmazásmenük elrejtése a menüsor elemeinek megjelenítésekor"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sembunyikan menu aplikasi saat menampilkan item bar menu"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nascondi i menu delle app quando vengono mostrati gli elementi della barra dei menu"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューバー項目を表示するときはアプリメニューを隠す"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메뉴 막대 항목 표시 시 앱 메뉴 숨기기"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verberg app-menu's bij het weergeven van menubalkitems"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukrywaj menu aplikacji podczas pokazywania elementów paska menu"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocultar menus do aplicativo ao exibir itens da barra de menus"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрывать меню приложений при отображении элементов строки меню"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ซ่อนเมนูแอปเมื่อแสดงรายการแถบเมนู"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menü çubuğu öğeleri gösterilirken uygulama menülerini gizle"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приховувати меню програм під час показу об'єктів рядка меню"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẩn menu ứng dụng khi hiển thị các mục trên thanh menu"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示菜单栏项目时隐藏应用菜单"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顯示選單列項目時隱藏應用程式選單"
          }
        }
      }
    },
    "Hide apps with the switch System Settings uses, so Live Activities and the camera indicator stay visible." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用系统设置所用的开关隐藏应用，让实时活动和相机指示器保持显示。"
          }
        }
      }
    },
    "Hide destinations you don't use. Hidden panes stay reachable through search." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐藏你不用的目标。隐藏的面板仍可通过搜索访问。"
          }
        }
      }
    },
    "Hide every managed menu bar item until toggled again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐藏所有受管理的菜单栏项目，直到再次切换。"
          }
        }
      }
    },
    "Hide the Hidden and Always Hidden items and keep hovering from revealing them. Turning it off brings back what was showing." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐藏隐藏和始终隐藏项目，并阻止悬停将其重新显示。关闭后会恢复当时显示的项目。"
          }
        }
      }
    },
    "Hide the menu bar in every Space" : {
      "comment" : "Toggle in the Spaces settings pane that hides the system menu bar in every Space.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在每个空间中隐藏菜单栏"
          }
        }
      }
    },
    "Hide the menu bar in this Space" : {
      "comment" : "Toggle in the Spaces settings pane that hides the system menu bar in the current Space.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在此空间中隐藏菜单栏"
          }
        }
      }
    },
    "Hide this from a different destination first" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先从其他目标隐藏此项目"
          }
        }
      }
    },
    "Hides the system menu bar in every context, full screen included." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在所有场景中隐藏系统菜单栏，包括全屏。"
          }
        }
      }
    },
    "Hides the system menu bar in every context, full screen included. This is the blunt instrument: prefer the per-Space control above when only one Space needs it." : {
      "comment" : "Annotation for the hide-menu-bar-everywhere toggle in the Spaces settings pane.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在所有场景中隐藏系统菜单栏，包括全屏。这是全局控制；只需影响一个空间时，建议使用上面的按空间控制。"
          }
        }
      }
    },
    "Hides the system menu bar only while this Space is showing. Other Spaces keep their current behavior." : {
      "comment" : "Annotation for the per-Space hide-menu-bar toggle in the Spaces settings pane.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在显示此空间时隐藏系统菜单栏。其他空间保持当前行为。"
          }
        }
      }
    },
    "Hides your Hidden and Always Hidden items while a display is mirrored or your screen is shared, then brings them back." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
