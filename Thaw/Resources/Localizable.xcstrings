        }
      }
    },
    "%@ 3 is rebuilt for macOS 27: a new settings window, keyboard search across your menu bar, and rules that bring an item back when you need it." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 3 针对 macOS 27 进行了重建：新的设置窗口、菜单栏上的键盘搜索以及在需要时返回项目的规则。"
          }
        }
      }
    },
