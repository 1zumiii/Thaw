          "stringUnit" : {
            "state" : "translated",
            "value" : "绘制在填充层上。"
          }
        }
      }
    },
    "Draws black over the corners of every display, so they look rounded." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
