          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "项目排列设置为手动，因此 %@ 只能隐藏和显示项目。要在这里重新排列，请在设置 %@ 布局中切换为自动，或自行按住 ⌘ 在菜单栏中拖动项目。"
          }
        }
      }
    },
