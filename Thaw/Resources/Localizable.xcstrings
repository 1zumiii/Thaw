        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅 Thaw 工具栏"
          }
        }
      }
    },
    "Thaw Bar Only items" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅 Thaw 工具栏项目"
          }
        }
      }
    },
    "Thaw can’t read Control Center’s settings." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thaw 无法读取控制中心的设置。"
          }
        }
      }
    },
    "Thaw couldn’t save the hidden menu bar app settings. Recovery information has been kept." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thaw 无法保存隐藏菜单栏应用的设置。恢复信息已保留。"
          }
        }
      }
    },
    "Thaw is capturing nothing. Screen Recording permission has not been granted." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thaw 没有截取任何内容。尚未授予“屏幕录制”权限。"
          }
        }
      }
    },
    "Thaw is ready to manage your menu bar." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thaw 已准备好管理菜单栏。"
          }
        }
      }
    },
    "Thaw isn't running yet. Open Thaw and try again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thaw 尚未运行。请打开 Thaw 后重试。"
          }
        }
      }
    },
    "Thaw keeps items in the order you set in Layout. To move another app’s item it sometimes has to drag it for you, and your mouse is briefly unavailable while it does." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thaw 会按你在布局中设置的顺序保留项目。移动其他应用的项目时，Thaw 有时需要代你拖动项目，此时鼠标会短暂不可用。"
          }
        }
      }
    },
    "Thaw reads a %lld × %lld pt band at the top of the display. Nothing else on screen is captured." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Thaw reads a %1$lld × %2$lld pt band at the top of the display. Nothing else on screen is captured."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thaw 会读取显示器顶部一条 %lld × %lld pt 的区域。屏幕上的其他内容不会被截取。"
          }
        }
      }
    },
    "Thaw reads a band at the top of the display. Nothing else on screen is captured." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thaw 会读取显示器顶部的一条区域。屏幕上的其他内容不会被截取。"
          }
        }
      }
    },
    "Thaw still needs to restore these apps: %@. Recovery information has been kept." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thaw 仍需恢复这些应用：%@。恢复信息已保留。"
